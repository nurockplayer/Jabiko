# Enforce LF line endings for all text files in the repo (issue #67).
# Removes the CRLF-in-repo drift on examBlocks.ts / contentStats.ts and keeps
# future commits LF regardless of each contributor's core.autocrlf setting.
* text=auto eol=lf

*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.svg  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary assets — never normalize line endings.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
