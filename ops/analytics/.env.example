# ops/analytics — documented environment (never put real secrets here).
# Copy to ops/analytics/.env and fill in locally; the file is gitignored.

# --- Cloudflare (required for apply; optional for plan/smoke discovery) ---
# Scoped API token: Zone > Zaraz : Edit, Zone > Zone : Read, restricted to the
# jabiko.app zone. Create it in the Cloudflare dashboard → My Profile → API
# Tokens. plan/apply/smoke read this variable.
CLOUDFLARE_API_TOKEN=

# --- Google (any ONE of the following) ---
# 1. One-shot access token (expires; fine for a single run).
GA4_ACCESS_TOKEN=
# 2. Path to a service-account JSON with analytics access on the GA4 property.
GOOGLE_APPLICATION_CREDENTIALS=
# 3. Or drop the JSON into ops/analytics/.secrets/ (gcp-service-account.json or
#    google-oauth.json) — see bin/google-auth for the exact options.
