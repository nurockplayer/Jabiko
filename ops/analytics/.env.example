# ops/analytics — variable-name reference only. Never put real secrets here.
#
# The operator CLIs do NOT auto-load ops/analytics/.env and do not shell-source
# this file. Export credentials in the shell (or use the documented Google
# credential files) before invoking bin/plan, bin/apply, bin/smoke, or
# bin/google-auth. This keeps documentation aligned with executable behavior.

# Cloudflare: normal operation needs Zone > Zaraz : Edit + Zone > Zone : Read,
# restricted to jabiko.app. If the zone uses preview workflow, POST /publish
# requires Zaraz Admin; apply fails closed with HUMAN_GATE:CLOUDFLARE_PUBLISH
# rather than pretending preview is live.
# export CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_API_TOKEN=

# Google: any ONE of the following.
# export GA4_ACCESS_TOKEN=...                  # one-shot access token
# export GOOGLE_APPLICATION_CREDENTIALS=...   # service-account JSON path
GA4_ACCESS_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=

# Or place a supported Google credential in ops/analytics/.secrets/; see
# bin/google-auth. The .secrets directory is gitignored.
