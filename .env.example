VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Zaraz analytics gate (#404). Set to "true" to enable
# production tracking via the Zaraz snippet. dev/test stay OFF regardless.
VITE_ZARAZ_ENABLED=true

# Google AdSense foundation (#772). Mode B defaults are intentionally OFF.
# Never use invented values: IDs must be copied from the approved account.
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_FOCUS_BREAK_POLICY_ELIGIBLE=false
VITE_ADSENSE_PUBLISHER_ID=
VITE_ADSENSE_FOCUS_BREAK_SLOT=
